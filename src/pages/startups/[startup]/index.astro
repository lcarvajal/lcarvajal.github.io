---
import { getCollection } from "astro:content";
import Project from "../../../components/Project.astro";
import SubpageLayout from "../../../components/SubpageLayout.astro";

export async function getStaticPaths() {
  const [keyProjects, startups] = await Promise.all([
    getCollection("keyProjects"),
    getCollection("startups"),
  ]);

  return startups.map((startup) => ({
    params: { startup: startup.id },
    props: {
      startup,
      keyProjects: keyProjects
        .filter((project) => project.data.startup === startup.id)
        .sort((a, b) => a.data.order - b.data.order),
    },
  }));
}

const { startup, keyProjects } = Astro.props;
const projectLinks = keyProjects.map((project) => ({
  label: project.data.title,
  href: `/startups/${startup.id}/projects/${project.id.split("/").at(-1)}/`,
}));
const startupUrl = new URL(`/startups/${startup.id}/`, Astro.site);
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Startup portfolio",
      item: new URL("/", Astro.site).toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: startup.data.name,
      item: startupUrl.toString(),
    },
  ],
};
---

<SubpageLayout
  title={`${startup.data.name} · Lukas Carvajal`}
  description={startup.data.summary}
  heading={startup.data.name}
  breadcrumbs={[{ label: "Startup portfolio", href: "/" }]}
  structuredData={breadcrumbSchema}
>
  <div
    slot="heading-media"
    class:list={["startup-logo", `startup-logo--${startup.id}`]}
  >
    <img src={startup.data.logo} alt={`${startup.data.name} logo`} />
  </div>

  <Project
    title={startup.data.title}
    summary={startup.data.summary}
    highlights={startup.data.highlights}
    {projectLinks}
    recommendation={startup.data.recommendation}
  />
</SubpageLayout>

<style>
  .startup-logo {
    box-sizing: border-box;
    display: grid;
    min-height: var(--height-project-logo-background);
    padding: var(--space-8) var(--space-12);
    place-items: center;
  }

  .startup-logo--friends-in-flats {
    background: var(--color-brand-friends-in-flats);
  }

  .startup-logo--mimo {
    background: var(--color-brand-mimo);
  }

  .startup-logo--tip-yourself {
    background: var(--color-brand-tip-yourself);
  }

  .startup-logo--friends-in-flats img {
    filter: brightness(0) invert(1);
  }

  .startup-logo img {
    display: block;
    width: 100%;
    max-width: var(--width-project-logo);
    max-height: var(--space-16);
    object-fit: contain;
    object-position: center;
  }
</style>
