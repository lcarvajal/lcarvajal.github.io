---
import { getCollection, render } from "astro:content";
import SubpageLayout from "../../../components/SubpageLayout.astro";

export async function getStaticPaths() {
  const [recommendations, startups] = await Promise.all([
    getCollection("recommendations"),
    getCollection("startups"),
  ]);

  return recommendations.map((recommendation) => {
    const recommendationPath = `/recommendations/${recommendation.id}`;
    const startup = startups.find(
      ({ data }) =>
        data.recommendation?.href.replace(/\/$/, "") === recommendationPath,
    );

    return {
      params: { id: recommendation.id },
      props: { recommendation, startup },
    };
  });
}

const { recommendation, startup } = Astro.props;
const { Content } = await render(recommendation);
const breadcrumbs = startup
  ? [
      { label: "Startup portfolio", href: "/" },
      { label: startup.data.name, href: `/startups/${startup.id}/` },
    ]
  : [{ label: "Home", href: "/" }];
---

<SubpageLayout
  title={`${recommendation.data.author} · Recommendation · Lukas Carvajal`}
  description={`A recommendation from ${recommendation.data.author}.`}
  heading={`Recommendation from ${recommendation.data.author}`}
  {breadcrumbs}
>
  <img
    slot="heading-media"
    class="portrait"
    src={recommendation.data.image}
    alt={recommendation.data.author}
    loading="lazy"
  />
  <div class="quote">
    <Content />
  </div>
  <p>
    <strong>{recommendation.data.author}</strong>
    <br />
    {recommendation.data.role}
  </p>
</SubpageLayout>

<style>
  .portrait {
    display: block;
    width: var(--space-16);
    height: var(--space-16);
    object-fit: cover;
  }

  .quote {
    font-size: var(--text-lg);
  }
</style>
