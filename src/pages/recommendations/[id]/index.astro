---
import { getCollection, render } from "astro:content";
import SubpageLayout from "../../../components/SubpageLayout.astro";

export async function getStaticPaths() {
  const recommendations = await getCollection("recommendations");

  return recommendations.map((recommendation) => ({
    params: { id: recommendation.id },
    props: { recommendation },
  }));
}

const { recommendation } = Astro.props;
const { Content } = await render(recommendation);
---

<SubpageLayout
  title={`${recommendation.data.author} · Recommendation · Lukas Carvajal`}
  description={`A recommendation from ${recommendation.data.author}.`}
  heading={`Recommendation from ${recommendation.data.author}`}
  breadcrumbs={[{ label: "Home", href: "/" }]}
>
  <img
    slot="heading-media"
    class="portrait"
    src={recommendation.data.image}
    alt={recommendation.data.author}
    loading="lazy"
  />
  <div class="quote">
    <Content />
  </div>
  <p>
    <strong>{recommendation.data.author}</strong>
    <br />
    {recommendation.data.role}
  </p>
</SubpageLayout>

<style>
  .portrait {
    display: block;
    width: var(--space-16);
    height: var(--space-16);
    object-fit: cover;
  }

  .quote {
    font-size: var(--text-lg);
  }
</style>
