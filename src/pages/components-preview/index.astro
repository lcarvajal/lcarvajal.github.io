---
import BaseLayout from "../../layouts/BaseLayout.astro";

const components = [
  { name: "Current Project Highlight", href: "/components/current-project-highlight" },
  { name: "External Link", href: "/components/external-link" },
  { name: "Project", href: "/components/project" },
  { name: "Site Header", href: "/components/site-header" },
  { name: "Sticky Section", href: "/components/sticky-section" },
];
---

<BaseLayout title="Components · Lukas Carvajal" description="A living gallery of components created for this website.">
  <h1>Components</h1>
  <ul>
    {components.map((component) => (
      <li><a href={component.href}>{component.name}</a></li>
    ))}
  </ul>
</BaseLayout>
