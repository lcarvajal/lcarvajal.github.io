---
import LogoMarquee from "../../../components/LogoMarquee.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const logos = [
  {
    badge: "€84K monthly bookings",
    href: "/startups/friends-in-flats/",
    name: "Friends in Flats",
    src: "/resources/images/friends-in-flats-logo-blue.svg",
  },
  {
    badge: "€800K MRR",
    href: "/startups/mimo/",
    name: "Mimo",
    src: "/resources/images/mimo-logo-white.webp",
  },
  {
    badge: "acquired",
    href: "/startups/tip-yourself/",
    name: "Tip Yourself",
    src: "/resources/images/tip-yourself-logo-white.png",
  },
];
---

<BaseLayout title="Logo Marquee · Components · Lukas Carvajal">
  <h1>Logo Marquee</h1>
  <p>A continuously scrolling row of linked startup logos.</p>
  <LogoMarquee {logos} />
</BaseLayout>
