---
import BaseLayout from "../layouts/BaseLayout.astro";
import CurrentProjectHighlight from "../components/CurrentProjectHighlight.astro";
import Project from "../components/Project.astro";
import StickySection from "../components/StickySection.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects"))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Lukas Carvajal">
  <section class="opening full-bleed">
    <figure class="hero">
      <img
        src="/resources/images/lukas-working-with-mimo-team.jpg"
        alt="Lukas working with the Mimo team"
      />
      <figcaption>
          From left to right: Kevin, Lukas, Donatien, and Filip
      </figcaption>
    </figure>
    <div class="intro">
        <h1>10 / 10</h1>
      <p>Hope you're fired up for what I do</p>
    </div>
    <hr class="intro-divider" />
  </section>

  <StickySection title="Startup portfolio" description="">
    {projects.map(({ data }) => (
      <Project
        title={data.title}
        summary={data.summary}
        highlights={data.highlights}
        projectLinks={data.projectLinks}
        recommendation={data.recommendation}
      >
        <img slot="logo" src={data.logo} alt={`${data.name} logo`} />
      </Project>
    ))}
  </StickySection>

  <CurrentProjectHighlight
    title={"Now building:\nFriends in Flats"}
    description="Generating €50,000 MRR for landlords, the public listing site is free to explore without creating an account."
    href="https://friends-in-flats.com"
    linkLabel="Open website"
    image="/resources/images/friends-in-flats-home-page.png"
    imageAlt="Screen recording of the Friends in Flats apartment listings homepage"
    video="/resources/video/friends-in-flats-demo.mp4"
  />
</BaseLayout>

<style>
  .opening {
    display: grid;
    grid-template-rows: minmax(20rem, 1fr) auto auto;
    height: calc(
      100svh - var(--height-header-expanded) - var(--space-16) - var(--space-12)
    );
  }

  .hero {
    position: relative;
    box-sizing: border-box;
    width: 100%;
    min-height: 0;
    margin: 0;
    overflow: hidden;
    background: var(--color-text);
  }

  .hero img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(
      circle at center,
      transparent 50%,
      color-mix(in srgb, var(--color-text) 65%, transparent) 100%
    );
    pointer-events: none;
    content: "";
  }

  .hero figcaption {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-4);
    max-width: var(--width-text);
    color: var(--color-background);
    font-size: var(--text-sm);
    text-align: right;
    z-index: 2;
  }

  .intro {
    width: min(
      calc(100% - (2 * var(--page-padding))),
      var(--width-content)
    );
    margin-inline: auto;
    padding-top: var(--space-8);
  }

  .intro h1 {
    margin-block: 0 var(--space-3);
    font-size: var(--text-4xl);
  }

  .intro p {
    margin: 0;
  }

  .intro-divider {
    width: 100%;
    margin-block: var(--space-8) 0;
    margin-inline: 0;
    border: 0;
    border-top: 1px solid var(--color-text);
  }

  @media (max-width: 48rem) {
    .opening {
      height: calc(
        100svh - var(--height-header-compact) - var(--space-16) - var(--space-12)
      );
    }
  }
</style>
