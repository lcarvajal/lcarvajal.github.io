---
import BaseLayout from "../layouts/BaseLayout.astro";
import Acknowledgements from "../components/Acknowledgements.astro";
import CurrentProjectHighlight from "../components/CurrentProjectHighlight.astro";
import Project from "../components/Project.astro";
import StickySection from "../components/StickySection.astro";
import { getCollection } from "astro:content";

const startups = (await getCollection("startups"))
  .sort((a, b) => a.data.order - b.data.order);
const keyProjects = await getCollection("keyProjects");

const acknowledgementGroups = [
  {
    title: "Shaped me",
    names: ["Milton & Karoline Carvajal", "Dr Anthony Krupp", "Luis Carlos Perea"],
  },
  {
    title: "Bet on me",
    names: [
      "Dr Gokila Dorai",
      "Dave Carvajal",
      "The Tip Yourself Founders",
      "The Mimo Founders",
      "The Friends in Flats Founders",
      "Andrew Strait",
    ],
  },
  {
    title: "Built things with me",
    names: [
    "Samat Kadyrov",
    "Eric Strohmaier",
      "Lori Porumb",
      "Radu Meister",
      "Joseph O’Brien",
      "Filip Ruisl",
      "Helene Karlinger",
      "Christopher Simerle",
      "Filip Greš",
      "Thomas Sattlecker",
    ],
  },
];
---

<BaseLayout
  title="Lukas Carvajal - CTO and Product engineer"
  description="Lukas Carvajal co-founded Tip Yourself (aquired), ran a crucial part of the learning experience at Mimo, and now works on Friends in Flats, generating €80K+ in monthly bookings."
>
  <section class="opening full-bleed">
    <figure class="hero">
      <img
        src="/resources/images/lukas-working-with-mimo-team.jpg"
        alt="Lukas working with the Mimo team"
        width="1600"
        height="1200"
        fetchpriority="high"
      />
      <figcaption>
          From left to right: Kevin, Lukas, Donatien, and Filip
      </figcaption>
    </figure>
    <div class="intro">
        <h1>Launching startups since 2014</h1>
      <div class="intro-copy">
        <p>After launching Tip Yourself (aquired) and developing Mimo's core learning experience, I'm building Friends in Flats - a rental marketplace generating €80K+ in monthly bookings.</p>
      </div>
    </div>
    <hr class="intro-divider" />
  </section>

  <h2 class="portfolio-heading">Portfolio</h2>

  {startups.map(({ id, data }) => (
    <StickySection id={id}>
      {data.name === "Friends in Flats" || data.name === "Mimo" || data.name === "Tip Yourself" ? (
        <a
          class:list={[
            "portfolio-logo-background",
            {
              "portfolio-logo-background--mimo": data.name === "Mimo",
              "portfolio-logo-background--tip-yourself": data.name === "Tip Yourself",
              "portfolio-logo-background--friends-in-flats": data.name === "Friends in Flats",
            },
          ]}
          slot="title"
          href={`/startups/${id}/`}
          aria-label={`View ${data.name}`}
        >
          <img
            class="portfolio-logo"
            src={data.logo}
            alt={`${data.name} logo`}
          />
        </a>
      ) : (
        <a
          class="portfolio-logo-link"
          slot="title"
          href={`/startups/${id}/`}
          aria-label={`View ${data.name}`}
        >
          <img
            class="portfolio-logo"
            src={data.logo}
            alt={`${data.name} logo`}
          />
        </a>
      )}
      <Project
        title={data.title}
        summary={data.summary}
        highlights={data.highlights}
        projectLinks={keyProjects
          .filter((project) => project.data.startup === id)
          .sort((a, b) => a.data.order - b.data.order)
          .map((project) => ({
            label: project.data.title,
            href: `/startups/${id}/projects/${project.id.split("/").at(-1)}/`,
          }))}
        recommendation={data.recommendation}
      />
    </StickySection>
  ))}

  <CurrentProjectHighlight
    title={"Now building:\nFriends in Flats"}
    description="Generating €84,000 in monthly bookings, the public listing site is free to explore without creating an account."
    href="https://friends-in-flats.com"
    linkLabel="Open website"
    image="/resources/images/friends-in-flats-home-page.webp"
    imageAlt="Screen recording of the Friends in Flats apartment listings homepage"
    video="/resources/video/friends-in-flats-demo.mp4"
  />

  <Acknowledgements
    title="A special thanks to the people that"
    groups={acknowledgementGroups}
    note={"You make life a lot of fun and taught me loads over the years.\nEverything on this site happened because of you."}
  />
</BaseLayout>

<style>
  .opening {
    display: grid;
    grid-template-rows: minmax(20rem, 1fr) auto auto;
    height: calc(
      100svh - var(--height-header-expanded) - var(--space-16) - var(--space-12)
    );
  }

  .hero {
    position: relative;
    box-sizing: border-box;
    width: 100%;
    min-height: 0;
    margin: 0;
    overflow: hidden;
    background: var(--color-text);
  }

  .hero img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(
      circle at center,
      transparent 50%,
      color-mix(in srgb, var(--color-text) 65%, transparent) 100%
    );
    pointer-events: none;
    content: "";
  }

  .hero figcaption {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-4);
    max-width: var(--width-text);
    color: var(--color-background);
    font-size: var(--text-sm);
    text-align: right;
    z-index: 2;
  }

  .intro {
    width: min(
      calc(100% - (2 * var(--page-padding))),
      var(--width-content)
    );
    margin-inline: auto;
    padding-top: var(--space-8);
  }

  .intro-copy {
    width: min(100%, var(--width-text));
  }

  .intro h1 {
    margin-block: 0 var(--space-3);
    font-size: var(--text-4xl);
  }

  .intro p {
    margin: 0;
  }

  .intro-divider {
    width: 100%;
    margin-block: var(--space-8) 0;
    margin-inline: 0;
    border: 0;
    border-top: 1px solid var(--color-text);
  }

  .portfolio-heading {
    box-sizing: border-box;
    min-height: calc(var(--space-16) + var(--space-12));
    margin-block: 0;
    padding-top: var(--space-12);
    font-size: var(--text-3xl);
    line-height: var(--leading-heading);
  }

  .portfolio-logo {
    display: block;
    width: var(--width-project-logo);
    max-width: 100%;
    height: auto;
    object-fit: contain;
    object-position: left center;
  }

  .portfolio-logo-background {
    box-sizing: border-box;
    display: grid;
    place-items: center;
    width: 100%;
    height: var(--height-project-logo-background);
    padding: var(--space-8) var(--space-12);
    text-decoration: none;
  }

  .portfolio-logo-link {
    display: inline-block;
  }

  .portfolio-logo-background--mimo {
    background: var(--color-brand-mimo);
  }

  .portfolio-logo-background--tip-yourself {
    background: var(--color-brand-tip-yourself);
  }

  .portfolio-logo-background--friends-in-flats {
    background: var(--color-brand-friends-in-flats);
  }

  .portfolio-logo-background--friends-in-flats .portfolio-logo {
    filter: brightness(0) invert(1);
  }

  .portfolio-logo-background .portfolio-logo {
    width: var(--width-project-logo);
    margin: auto;
    object-position: center;
  }

  @media (max-width: 56rem) {
    .portfolio-logo-background,
    .portfolio-logo-link {
      max-width: var(--width-media);
    }
  }

  @media (max-width: 48rem) {
    .opening {
      height: calc(
        100svh - var(--height-header-compact) - var(--space-16) - var(--space-12)
      );
    }
  }
</style>
