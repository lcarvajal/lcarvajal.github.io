---
import BaseLayout from "../layouts/BaseLayout.astro";
import Project from "../components/Project.astro";
import StickySection from "../components/StickySection.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects"))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Lukas Carvajal">
  <div class="hero-placeholder full-bleed" aria-hidden="true"></div>
  <section class="intro">
    <h1>Welcome</h1>
    <p>Hope you enjoy seeing what I'm up to</p>
    <hr />
  </section>

  <StickySection title="Startup portfolio" description="Products I helped build and grow.">
    {projects.map(({ data }) => (
      <Project
        title={data.title}
        summary={data.summary}
        highlights={data.highlights}
        projectLinks={data.projectLinks}
      >
        <img slot="logo" src={data.logo} alt={`${data.name} logo`} />
      </Project>
    ))}
  </StickySection>
</BaseLayout>

<style>
  .hero-placeholder {
    height: min(60vh, 40rem);
    background: var(--color-text);
  }

  .intro {
    padding-top: var(--space-8);
  }

  .intro hr {
    margin-block: var(--space-8) 0;
    border: 0;
    border-top: 1px solid var(--color-border);
  }
</style>
