---
import { getCollection, render } from "astro:content";
import PhotoCarousel from "../../../components/PhotoCarousel.astro";
import SubpageLayout from "../../../components/SubpageLayout.astro";

export async function getStaticPaths() {
  const people = await getCollection("people");

  return people.map((person) => ({
    params: { person: person.id },
    props: { person },
  }));
}

const { person } = Astro.props;
const { Content } = await render(person);
---

<SubpageLayout
  title={`${person.data.name} · Lukas Carvajal`}
  description={person.data.description}
  heading={person.data.name}
  breadcrumbs={[{ label: "Acknowledgements", href: "/#acknowledgements" }]}
  largeBody
>
  <Content />

  <PhotoCarousel slot="after" photos={person.data.photos} />
</SubpageLayout>
