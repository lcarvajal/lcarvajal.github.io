---
import { getCollection, render } from "astro:content";
import Acknowledgements from "../../../components/Acknowledgements.astro";
import PhotoCarousel from "../../../components/PhotoCarousel.astro";
import SubpageLayout from "../../../components/SubpageLayout.astro";
import {
  acknowledgementGroups,
  acknowledgementNote,
  acknowledgementPages,
  acknowledgementTitle,
} from "../../../data/acknowledgements";

export async function getStaticPaths() {
  const contentBySlug = new Map(
    (await getCollection("people")).map((content) => [content.id, content]),
  );

  return acknowledgementPages.map((person) => {
    const content = contentBySlug.get(person.slug);

    if (!content) {
      throw new Error(`Missing acknowledgement content for '${person.slug}'.`);
    }

    return {
      params: { person: person.slug },
      props: { person, content },
    };
  });
}

const { person, content } = Astro.props;
const { Content } = await render(content);
---

<SubpageLayout
  title={`${person.name} · Lukas Carvajal`}
  description={person.description}
  heading={person.name}
  breadcrumbs={[{ label: "Acknowledgements", href: "/#acknowledgements" }]}
  largeBody
>
  <Content />

  <Fragment slot="after">
    <PhotoCarousel photos={person.photos} />
    <Acknowledgements
      title={acknowledgementTitle}
      groups={acknowledgementGroups}
      note={acknowledgementNote}
    />
  </Fragment>
</SubpageLayout>
