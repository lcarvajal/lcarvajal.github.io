---
import { getCollection, render } from "astro:content";
import Acknowledgements from "../../../components/Acknowledgements.astro";
import PhotoCarousel from "../../../components/PhotoCarousel.astro";
import SubpageLayout from "../../../components/SubpageLayout.astro";
import {
  acknowledgementGroups,
  acknowledgementNote,
  acknowledgementPages,
  acknowledgementTitle,
} from "../../../data/acknowledgements";

export async function getStaticPaths() {
  const contentBySlug = new Map(
    (await getCollection("acknowledgements")).map((content) => [
      content.id,
      content,
    ]),
  );

  return acknowledgementPages.map((acknowledgement) => {
    const content = contentBySlug.get(acknowledgement.slug);

    if (!content) {
      throw new Error(
        `Missing acknowledgement content for '${acknowledgement.slug}'.`,
      );
    }

    return {
      params: { acknowledgement: acknowledgement.slug },
      props: { acknowledgement, content },
    };
  });
}

const { acknowledgement, content } = Astro.props;
const { Content } = await render(content);
---

<SubpageLayout
  title={`Thanks ${acknowledgement.name} · Lukas Carvajal`}
  description={`An acknowledgement to ${acknowledgement.name} from Lukas`}
  heading={acknowledgement.name}
  breadcrumbs={[{ label: "Acknowledgements", href: "/#acknowledgements" }]}
  largeBody
  noindex
>
  <Content />

  <Fragment slot="after">
    <PhotoCarousel photos={acknowledgement.photos} />
    <Acknowledgements
      title={acknowledgementTitle}
      groups={acknowledgementGroups}
      note={acknowledgementNote}
    />
  </Fragment>
</SubpageLayout>
