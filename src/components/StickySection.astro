---
interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<section class="sticky-section">
  <header>
    <h2><slot name="title">{title}</slot></h2>
    {description && <p>{description}</p>}
  </header>

  <div class="content">
    <slot />
  </div>
</section>

<style>
  .sticky-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, var(--width-text));
    gap: var(--space-12);
    align-items: start;
    padding-block: var(--space-12);
  }

  header {
    position: sticky;
    top: calc(var(--height-header-current) + var(--space-4));
    transition: top var(--duration-normal) var(--ease-standard);
  }

  h2 {
    margin-block: 0 var(--space-3);
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    line-height: var(--leading-heading);
  }

  h2 :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: var(--space-16);
    object-fit: contain;
    object-position: left center;
  }

  p {
    max-width: var(--width-text);
    margin: 0;
    color: var(--color-text-muted);
  }

  .content {
    min-width: 0;
  }

  .content :global(.project) {
    padding-top: 0;
  }

  @media (max-width: 48rem) {
    .sticky-section {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    header {
      position: static;
      transition: none;
    }

  }
</style>
