---
interface Group {
  title: string;
  names: string[];
}

interface Props {
  title: string;
  groups: Group[];
  note: string;
}

const { title, groups, note } = Astro.props;
---

<section class="acknowledgements full-bleed">
  <div class="acknowledgements__inner">
    <h2>{title}</h2>

    <div class="acknowledgements__groups">
      {groups.map((group) => (
        <section>
          <h3>{group.title}</h3>
          <ul>
            {group.names.map((name) => <li>{name}</li>)}
          </ul>
        </section>
      ))}
    </div>

    <p class="acknowledgements__note">{note}</p>
  </div>
</section>

<style>
  .acknowledgements {
    background: var(--color-surface-muted);
  }

  .acknowledgements__inner {
    box-sizing: border-box;
    width: min(calc(100% - (2 * var(--page-padding))), var(--width-content));
    margin-inline: auto;
    padding-block: var(--space-16);
  }

  h2,
  h3 {
    margin: 0;
    font-family: var(--font-heading);
    line-height: var(--leading-heading);
  }

  h2 {
    max-width: var(--width-text);
    font-size: var(--text-2xl);
  }

  .acknowledgements__groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-12);
    margin-top: var(--space-16);
  }

  h3 {
    margin-bottom: var(--space-6);
    font-size: var(--text-xl);
  }

  ul {
    margin: 0;
    padding: 0;
    font-size: var(--text-lg);
    list-style: none;
  }

  .acknowledgements__note {
    max-width: var(--width-text);
    margin: var(--space-16) 0 0;
    font-size: var(--text-lg);
    white-space: pre-line;
  }

  @media (max-width: 48rem) {
    .acknowledgements__groups {
      grid-template-columns: 1fr;
      gap: var(--space-8);
      margin-top: var(--space-12);
    }

    h3 {
      margin-bottom: var(--space-3);
    }
  }
</style>
