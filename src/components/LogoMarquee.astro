---
interface Logo {
  badge: string;
  href: string;
  name: string;
  src: string;
}

interface Props {
  logos: Logo[];
}

const { logos } = Astro.props;
---

<div class="logo-marquee" data-testid="opening-marquee">
  <div class="logo-marquee__track" data-marquee-track>
    <div class="logo-marquee__group">
      {logos.map((logo) => (
        <a href={logo.href} aria-label={`View ${logo.name}: ${logo.badge}`}>
          <img src={logo.src} alt={`${logo.name} logo`} />
          <span>{logo.badge}</span>
        </a>
      ))}
    </div>
    <div class="logo-marquee__group" aria-hidden="true">
      {logos.map((logo) => (
        <a href={logo.href} tabindex="-1">
          <img src={logo.src} alt="" />
          <span>{logo.badge}</span>
        </a>
      ))}
    </div>
  </div>
</div>

<script>
  const pixelsPerSecond = 60;

  document
    .querySelectorAll<HTMLElement>("[data-marquee-track]")
    .forEach((track) => {
      const group = track.firstElementChild;

      if (!(group instanceof HTMLElement)) return;

      const setDuration = () => {
        const distance = group.getBoundingClientRect().width;
        const duration = distance / pixelsPerSecond;
        track.style.setProperty("--marquee-distance", `-${distance}px`);
        track.style.setProperty("--marquee-duration", `${duration}s`);
      };

      setDuration();
      new ResizeObserver(setDuration).observe(group);
    });
</script>

<style>
  .logo-marquee {
    box-sizing: border-box;
    width: 100%;
    overflow: hidden;
    border-bottom: 1px solid var(--color-background);
    background: var(--color-text);
  }

  .logo-marquee__track {
    display: flex;
    width: max-content;
    backface-visibility: hidden;
    transform: translate3d(0, 0, 0);
    will-change: transform;
    animation: marquee var(--marquee-duration, 10s) linear infinite;
  }

  .logo-marquee__group {
    box-sizing: border-box;
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-around;
    min-width: 100vw;
    gap: var(--space-16);
    padding: var(--space-6) var(--space-8);
  }

  a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-background);
    text-decoration: none;
  }

  img {
    display: block;
    width: auto;
    height: var(--height-marquee-logo);
    min-height: var(--height-marquee-logo);
    max-height: var(--height-marquee-logo);
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  span {
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    white-space: nowrap;
  }

  @keyframes marquee {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(var(--marquee-distance, -50%), 0, 0);
    }
  }

  @media (min-width: 48.001rem) {
    .logo-marquee__track {
      width: min(calc(100% - (2 * var(--page-padding))), var(--width-content));
      margin-inline: auto;
      animation: none;
    }

    .logo-marquee__group {
      justify-content: space-between;
      width: 100%;
      min-width: 0;
      padding-inline: 0;
    }

    .logo-marquee__group[aria-hidden="true"] {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-marquee__track {
      animation-play-state: paused;
    }
  }
</style>
